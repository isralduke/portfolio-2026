<a class="project-card card-hover" href="{{ item.url }}" aria-labelledby="{{ item.data.title | slugify }}">
	<div class="project-card__cover">
		<img src="{{ item.data.coverImage }}" alt="{{ item.data.coverImageAlt }}">
	</div>
	<div class="project-card__body" aria-labelledby="{{ item.data.title | slugify }}">
		<h3 class="project-card__title" id="{{ item.data.title | slugify }}">{{ item.data.title }}</h3>
		<p class="project-card__excerpt">{{ item.data.excerpt }}</p>
	</div>
</a>
