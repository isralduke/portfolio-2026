<section class="section" id="references">
	<h2 class="section__eyebrow">References</h2>
	<div class="refs-grid">
		{% for item in references %}
			<a class="ref-card" href="{{ item.link }}" target="_blank" rel="noopener noreferrer">
				<img src="{{ item.image }}" alt="{{ item.name }}’s LinkedIn avatar." class="ref-card__avatar" width="2.75rem" height="2.75rem">
				<span class="ref-card__text">
					<span class="ref-card__name">{{ item.name }}</span>
					<span class="ref-card__desc">{{ item.title }} at {{ item.employer }}</span>
				</span>
			</a>
		{% endfor %}
	</div>
</section>
	