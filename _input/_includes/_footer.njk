<footer class="site-footer" id="contact">
	<div class="site-footer__hire">
		<p>Hire me.</p>
	</div>
	<div class="site-footer__grid">
		<div>
			<div class="footer-brand">
				<span class="brand__mark" aria-hidden="true">{{ site.brand.mark }}</span>
				<span class="brand__name">{{ site.brand.name }}</span>
			</div>
			<p class="site-footer__blurb">{{ site.footerBlurb | safe }}</p>
			<a class="linkedin-link" href="{{ site.linkedin }}" target="_blank" rel="noopener noreferrer">
				<span class="linkedin-link__dot" aria-hidden="true"></span>
				Connect on LinkedIn &rarr;
			</a>
		</div>
		<div class="footer-col">
			<p class="footer-col__label">Skills</p>
			<ul>
				{% for skill in site.skills %}
					<li>{{ skill.title }}</li>
				{% endfor %}
			</ul>
		</div>
		<div class="footer-col">
			<p class="footer-col__label">Certifications</p>
			<ul>
				{% for cert in site.certsBrief %}
					<li><a href="{{ cert.link }}" target="_blank" rel="noopener noreferrer">{{ cert.title }}</a></li>
				{% endfor %}
			</ul>
		</div>
	</div>
	<nav class="site-footer__links" aria-label="Footer">
		{% for item in site.nav %}
			<a href="{{ item.href }}">{{ item.label }}</a>
		{% endfor %}
		<a href="{{ site.resume }}" target="_blank" rel="noopener noreferrer">Resume</a>
	</nav>
	<div class="site-footer__legal">
		<div class="site-footer__legal-row">
			<span>&copy; 2026 {{ site.name }}</span>
			<span>{{ site.location }}</span>
		</div>
	</div>
</footer>
