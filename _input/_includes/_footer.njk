<footer class="site-footer" id="contact">
	<div class="site-footer__hire">
		<p>Hire me.</p>
	</div>
	<div class="site-footer__grid">
		<div>
			<div class="footer-brand">
				<span class="brand__mark" aria-hidden="true">
					{% include "svg/isral-duke-logo-mark.svg" %}
				</span>
				<span class="brand__name">ISRAL DUKE</span>
			</div>
			<p class="site-footer__blurb">UI, UX &amp; accessibility designer building standards-compliant products people can actually use.</p>
			<a class="linkedin-link" href="https://linkedin.com/in/isralduke" target="_blank" rel="noopener noreferrer">
				<span class="linkedin-link__dot" aria-hidden="true"></span>
				Connect on LinkedIn &rarr;
			</a>
		</div>
		<div class="footer-col">
			<p class="footer-col__label">Skills</p>
			<ul>
				{% for item in skills | batch(4) | first %}
					<li>{{ item.title }}</li>
				{% endfor %}
			</ul>
		</div>
		<div class="footer-col">
			<p class="footer-col__label">Certifications</p>
			<ul>
				{% for item in certifications | batch(4) | first %}
					<li>
						<a href="{{ item.link }}" target="_blank" rel="noopener noreferrer">{{ item.title }}</a>
					</li>
				{% endfor %}
			</ul>
		</div>
	</div>
	<nav class="site-footer__links" aria-label="Footer">
		<a href="index.html#work">All Projects</a>
		<a href="index.html#contact">Contact</a>
		<a href="index.html#certs">Certifications</a>
		<a href="index.html#skills">Skills</a>
		<a href="index.html#references">References</a>
		<a href="resume.pdf" target="_blank" rel="noopener noreferrer">Resume</a>
	</nav>
	<div class="site-footer__legal">
		<div class="site-footer__legal-row">
			<span>&copy; 2026 Isral Duke</span>
			<span>Baton Rouge, Louisiana</span>
		</div>
	</div>
</footer>
