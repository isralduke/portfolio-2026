<section class="section section--work" id="work">
	<h2 class="section__eyebrow">Selected Work</h2>
	{% for item in collections["product-design"] %}
		{% if item.data.featured %}
			<a class="featured-project" href="{{ item.url}}">
				<div class="featured-project__cover">
					{# <span class="placeholder-tag">cover &middot; {{ item.title }}</span> #}
					<img src="{{ item.data.coverImage }}" alt="{{ item.data.coverImageAlt }}">
				</div>
				<div class="featured-project__body">
					<div>
						<div class="featured-project__kicker">01 / FEATURED</div>
						<h3 class="featured-project__title">{{ item.data.title }}</h3>
					</div>
					<p class="featured-project__excerpt">{{ item.data.excerpt }}</p>
				</div>
			</a>
		{% endif %}
	{% endfor %}
	<div class="project-grid">
		{% for item in collections["product-design"] %}
			{% if not item.data.featured %}
			<a class="project-card" href="{{ item.url }}">
				<div class="project-card__cover">
					<img src="{{ item.data.coverImage }}" alt="{{ item.data.coverImageAlt }}">
				</div>
				<div class="project-card__body">
					<h3 class="project-card__title">{{ item.data.title }}</h3>
					<p class="project-card__excerpt">{{ item.data.excerpt }}</p>
				</div>
			</a>
			{% endif %}
		{% endfor %}
	</div>
</section>
